{
  "name": "imagelinks",
  "version": "0.1.3",
  "description": "Extract QR codes and URLs from images",
  "author": "Brian Cantoni",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "jest --verbose",
    "format": "prettier --write \"**/*.{js,json,html,css}\"",
    "format:check": "prettier --check \"**/*.{js,json,html,css}\"",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --x64 --win --publish never",
    "build:linux": "electron-builder --linux --publish never"
  },
  "keywords": [
    "electron",
    "qrcode",
    "ocr",
    "url-extractor"
  ],
  "license": "MIT",
  "devDependencies": {
    "electron": "^39.2.3",
    "electron-builder": "^26.0.12",
    "jest": "^29.7.0",
    "prettier": "^3.1.1"
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "sharp": "^0.34.5",
    "tesseract.js": "^6.0.1"
  },
  "build": {
    "appId": "com.imagelinks.app",
    "productName": "ImageLinks",
    "copyright": "Copyright © 2025 Brian Cantoni",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.utilities"
    },
    "dmg": {
      "writeUpdateInfo": false
    },
    "fileAssociations": [
      {
        "ext": "jpg",
        "name": "JPEG Image",
        "role": "Viewer"
      },
      {
        "ext": "jpeg",
        "name": "JPEG Image",
        "role": "Viewer"
      },
      {
        "ext": "png",
        "name": "PNG Image",
        "role": "Viewer"
      },
      {
        "ext": "heic",
        "name": "HEIC Image",
        "role": "Viewer"
      },
      {
        "ext": "webp",
        "name": "WebP Image",
        "role": "Viewer"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility"
    }
  }
}
